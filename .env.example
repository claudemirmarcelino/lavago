# Somente configuração local. Copie para .env; não use credenciais de produção.
# Este arquivo não é carregado automaticamente pelos scripts npm.
LAVAGO_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
# Preencher localmente após npm run dev:status. Chave pública, sujeita a RLS.
SUPABASE_PUBLISHABLE_KEY=
# Exclusivo de backend. Nunca copiar para o aplicativo ou documentação.
SUPABASE_SERVICE_ROLE_KEY=
